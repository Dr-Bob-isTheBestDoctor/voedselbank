{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "YOUR_TENANT_ID",
    "ClientId": "YOUR_CLIENT_ID",
    "ClientSecret": "YOUR_CLIENT_SECRET",
    "CallbackPath": "/signin-oidc",
    "Scope": "User.Read"
  },
  "Jwt": {
    "Key": "THIS_IS_A_VERY_SECRET_KEY_CHANGEME_1234567890",
    "Issuer": "BlazorAppApi",
    "Audience": "BlazorAppClient",
    "ExpireDays": 7
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=blazordb;Uid=root;Pwd=your_mysql_password;"
  }

}