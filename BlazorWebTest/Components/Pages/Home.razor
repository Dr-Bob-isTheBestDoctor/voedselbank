@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.EntityFrameworkCore.ValueGeneration.Internal
@using Microsoft.Identity.Client
@rendermode InteractiveServer
@attribute [AllowAnonymous]

<PageTitle>Dagoverzicht</PageTitle>

<h1>Dagoverzicht</h1>

Welcome to your new app.

<button class="btn btn-primary oproepbtn" @onclick="AddNewOproep">
    Oproep plaatsen
</button>

<div class="oproepdiv">
    @DynamicContent
    <div class="TextOproep">
        <div class="OproepBanner">
            <h1>uitdelen van voedsel</h1>
        </div>
        <div class="TxtOproepInfo">
            <div class="vline">
                <h1 class="datumtext">Donderdag 14:00-16:00</h1>
            </div>
            <div class="positionsavailable">
                <h1 class="positionTxt">1 van 4 plekken bezet</h1>
                <button class="Registerbtn">
                    Aanmelden
                </button>
            </div>
        </div>
    </div>
    <div class="ImageOproep">
        <div class="OproepBanner">
            <h1>uitdelen van voedsel</h1>
        </div>
    </div>
</div>

@code {
    private List<string> Oproepen = new();

    private RenderFragment DynamicContent => builder =>
    {
        int seq = 0;

        foreach (var oproep in Oproepen)
        {
            //AddOproep(builder, oproep, "ImageOproep", ref seq);
            Website.MaakOproep(false, "Test", "", builder, ref seq);
        }
    };

    private void AddNewOproep()
    {
        Oproepen.Add($"Oproep {Oproepen.Count + 1}");
    }
