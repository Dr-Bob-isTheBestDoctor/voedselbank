@page "/local-login"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@attribute [AllowAnonymous]
@inject UserManager<IdentityUser> UserManager
@inject SignInManager<IdentityUser> SignInManager
@inject JwtTokenService TokenService
@inject NavigationManager Navigation

<PageTitle>Local login</PageTitle>

<h3>Local User Login</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<EditForm Model="model" OnValidSubmit="HandleLogin" FormName="LocalLoginForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Username:</label>
        <InputText @bind-Value="model.Username" class="form-control" autocomplete="username" />
    </div>

    <div class="mb-3">
        <label>Password:</label>
        <InputText type="password" @bind-Value="model.Password" class="form-control" autocomplete="current-password" />
    </div>

    <button type="submit" class="btn btn-primary">Log In</button>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private LoginModel model { get; set; } = new();

    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    private string? ReturnUrl { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? errorMessage;

    private async Task HandleLogin()
    {
        // 1. Check username + password against ASP.NET Core Identity (MySQL)
        var user = await UserManager.FindByNameAsync(model.Username);
        if (user is null ||
            !(await SignInManager.CheckPasswordSignInAsync(user, model.Password, lockoutOnFailure: false)).Succeeded)
        {
            errorMessage = "Invalid username or password.";
            return;
        }

        // 2. Create a JWT with the user's roles from the database (same token the API returns)
        var roles = await UserManager.GetRolesAsync(user);
        var token = TokenService.CreateToken(user, roles);

        // 3. End any Microsoft (admin) session and store the JWT in a secure HttpOnly cookie
        await HttpContext.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
        HttpContext.Response.Cookies.Append(AuthConstants.TokenCookieName, token, TokenService.CreateCookieOptions(HttpContext.Request));

        Navigation.NavigateTo(AuthConstants.SafeReturnUrl(ReturnUrl), forceLoad: true);
    }

    public class LoginModel
    {
        [Required]
        public string Username { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }
}
